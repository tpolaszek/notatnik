{
  "name": "C++",
  "extensions": ["cpp", "h", "hpp", "cxx", "cc"],
  "rules": [
    {
      "name": "keyword.control",
      "pattern": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|goto|try|catch|throw)\\b",
      "color": "#C586C0",
      "bold": true
    },
    {
      "name": "keyword.storage",
      "pattern": "\\b(static|const|volatile|mutable|auto|register|thread_local|extern|inline|explicit|friend|virtual|override|final)\\b",
      "color": "#569CD6",
      "bold": false
    },
    {
      "name": "entity.name.type",
      "pattern": "\\b(int|long|short|char|void|float|double|bool|wchar_t|char16_t|char32_t|size_t|uint[0-9]+_t|int[0-9]+_t|QString|string|vector|map|set|unique_ptr|shared_ptr)\\b",
      "color": "#4EC9B0"
    },
    {
      "name": "keyword.operator",
      "pattern": "(\\+|\\-|\\*|\\/|%|==|!=|<=|>=|<|>|&&|\\|\\||!|&|\\||\\^|~|<<|>>|=|[\\+\\-\\*/%&\\|\\^]=|\\.|->|::)",
      "color": "#D4D4D4"
    },
    {
      "name": "entity.name.function",
      "pattern": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()",
      "color": "#DCDCAA"
    },
    {
      "name": "meta.preprocessor",
      "pattern": "^\\s*#\\s*(include|define|undef|if|ifdef|ifndef|else|elif|endif|pragma)\\b",
      "color": "#C586C0"
    },
    {
      "name": "string.quoted",
      "pattern": "\"[^\"]*\"|'[^']*'",
      "color": "#CE9178"
    },
    {
      "name": "comment.line",
      "pattern": "//.*",
      "color": "#6A9955",
      "italic": true
    },
    {
      "name": "comment.block",
      "pattern": "/\\*[\\s\\S]*?\\*/",
      "color": "#6A9955",
      "italic": true
    },
    {
      "name": "constant.numeric",
      "pattern": "\\b(0x[0-9a-fA-F]+|0b[01]+|[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?)\\b",
      "color": "#B5CEA8"
    }
  ]
}