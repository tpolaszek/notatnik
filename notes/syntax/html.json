{
  "name": "HTML",
  "extensions": ["html", "htm"],
  "includes": ["css.json", "js.json", "php.json"],
  "rules": [
    {
      "name": "doctype",
      "pattern": "<!DOCTYPE[^>]*>",
      "color": "#808080",
      "italic": true
    },
    {
      "name": "comment",
      "pattern": "<!--[\\s\\S]*?-->",
      "color": "#6A9955",
      "italic": true
    },
    {
      "name": "tag",
      "pattern": "</?[a-zA-Z][a-zA-Z0-9]*",
      "color": "#4EC9B0",
      "bold": true
    },
    {
      "name": "tag_close",
      "pattern": "(?<!DOCTYPE html)/?>",
      "color": "#4EC9B0",
      "bold": true
    },
    {
      "name": "attribute",
      "pattern": "\\b(class|id|src|href|alt|type|name|value|placeholder|action|method|style|rel|target|title|width|height|lang|charset|content|defer|async)\\b",
      "color": "#9CDCFE"
    },
    {
      "name": "attribute_value_double",
      "pattern": "\"[^\"]*\"",
      "color": "#CE9178"
    },
    {
      "name": "attribute_value_single",
      "pattern": "'[^']*'",
      "color": "#CE9178"
    },
    {
      "name": "entity",
      "pattern": "&[a-zA-Z]+;|&#[0-9]+;|&#x[0-9a-fA-F]+;",
      "color": "#569CD6"
    },
    {
      "name": "inline_style_tag",
      "pattern": "<style[^>]*>",
      "color": "#C586C0",
      "bold": true
    },
    {
      "name": "inline_script_tag",
      "pattern": "<script[^>]*>",
      "color": "#C586C0",
      "bold": true
    }
  ]
}