<RCC>
    <qresource prefix="/syntax">
        <file>syntax/html.json</file>
        <file>syntax/cpp.json</file>
        <file>syntax/python.json</file>
        <file>syntax/css.json</file>
        <file>syntax/js.json</file>
        <file>syntax/php.json</file>
    </qresource>
    <qresource prefix="/themes">
        <file alias="dark.css">themes/dark.css</file>
        <file alias="light.css">themes/light.css</file>
    </qresource>
    <qresource prefix="/">
        <file>icons/preview.png</file>
        <file>icons/edit.png</file>
        <file>icons/note_icon.png</file>
        <file>icons/close.png</file>
        <file>icons/settings.png</file>
    </qresource>
    <qresource prefix="/dictionary">
        <file>dictionary/cpp.json</file>
        <file>dictionary/html.json</file>
        <file>dictionary/py.json</file>
        <file>dictionary/css.json</file>
        <file>dictionary/js.json</file>
        <file>dictionary/php.json</file>
    </qresource>
</RCC>
